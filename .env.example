# Copy this file to .env on your server, then fill in real values.
# Do not commit .env to GitHub.

# DingTalk robot webhook. Robot message content must match your DingTalk security keyword.
DINGTALK_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=your_access_token

# Binance USD-M Futures API credentials.
# Use testnet credentials while API_TRADING_TESTNET is enabled in the page.
BINANCE_API_KEY=your_binance_api_key
BINANCE_API_SECRET=your_binance_api_secret

# Required by the page before changing API trading settings.
ADMIN_ACTION_KEY=change_this_admin_key

# Mainnet live trading is blocked unless this exact confirmation is set.
# Keep this empty for testnet.
BINANCE_LIVE_TRADING_CONFIRM=
# BINANCE_LIVE_TRADING_CONFIRM=I_UNDERSTAND_REAL_MONEY
